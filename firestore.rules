rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y escribir su propio documento y sus recordatorios.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /recordatorios/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
